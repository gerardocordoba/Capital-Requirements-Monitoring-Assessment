				lineageTag: 50f0d1ff-296d-42df-ae2b-cf4846995d64
				summarizeBy: none
				isNameInferred
				sourceColumn: [Quarter]

				annotation SummarizationSetBy = Automatic

			column MonthNumber
				isHidden
				formatString: 0
				lineageTag: d5bdc74c-e59b-4b35-9343-1ebfba0d1dc4
				summarizeBy: sum
				isNameInferred
				sourceColumn: [MonthNumber]

				annotation SummarizationSetBy = Automatic

			column MonthName
				lineageTag: 99757f57-09b4-457d-86a1-6bbfd0bf8186
				summarizeBy: none
				isNameInferred
				sourceColumn: [MonthName]
				sortByColumn: MonthNumber

				annotation SummarizationSetBy = Automatic

			column YearMonth
				lineageTag: 8127f974-c986-4ba1-9df2-d197686bcb95
				summarizeBy: none
				isNameInferred
				sourceColumn: [YearMonth]

				annotation SummarizationSetBy = Automatic

			column YearMonthKey
				isHidden
				formatString: 0
				lineageTag: 19edcfcc-3631-4ff4-ac59-76b35ce7edbe
				summarizeBy: count
				isNameInferred
				sourceColumn: [YearMonthKey]

				annotation SummarizationSetBy = Automatic

			column MonthEnd
				formatString: dd/mm/yy
				lineageTag: 596e0dd3-af3d-444e-933c-fce356bdc6d8
				summarizeBy: none
				isNameInferred
				sourceColumn: [MonthEnd]

				annotation SummarizationSetBy = Automatic

				annotation UnderlyingDateTimeDataType = Date

				annotation PBI_FormatHint = {"isCustom":true}

			column IsMonthEnd
				formatString: """TRUE"";""TRUE"";""FALSE"""
				lineageTag: 89cbd914-0c14-4543-a71b-a51ebb5915a6
				summarizeBy: none
				isNameInferred
				sourceColumn: [IsMonthEnd]

				annotation SummarizationSetBy = Automatic

			column 'Has Data' = Dim_Date[Date] IN VALUES(Fact_Exposure[ReportMonth])
				formatString: """TRUE"";""TRUE"";""FALSE"""
				lineageTag: 85600e1e-5ab4-43d4-bff3-b1985e1dd6d9
				summarizeBy: none

				annotation SummarizationSetBy = Automatic

			partition Dim_Date = calculated
				mode: import
				source =
						
						ADDCOLUMNS(
						    CALENDAR( DATE( 2026, 1, 1 ), DATE( 2026, 12, 31 ) ),
						    "Year", YEAR( [Date] ),
						    "Quarter", "Q" & QUARTER( [Date] ),
						    "MonthNumber", MONTH( [Date] ),
						    "MonthName", FORMAT( [Date], "MMM" ),
						    "YearMonth", FORMAT( [Date], "yyyy-MM" ),
						    "YearMonthKey", YEAR( [Date] ) * 100 + MONTH( [Date] ),
						    "MonthEnd", EOMONTH( [Date], 0 ),
						    "IsMonthEnd", [Date] = EOMONTH( [Date], 0 )
						)

			annotation PBI_Id = 8b2f1ef7597742e29d265f220b1a0a2d

		table _Measures
			lineageTag: d39b6cad-6eb7-4a6c-935d-0d99052fdb98

			measure 'Total RWA' = SUM(Fact_Exposure[RWA])
				formatString: 0
				displayFolder: 1 - RWA
				lineageTag: d6281b27-95db-4fc8-8a71-c4be5c172eeb

			measure 'Total Exposure' = Sum(Fact_Exposure[ExposureEUR])
				displayFolder: 3 - Other
				lineageTag: 45ab8ab8-ed78-497b-8053-08f9a0653eeb

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'RWA Density' = DIVIDE([Total RWA],[Total Exposure])
				displayFolder: 1 - RWA
				lineageTag: 91dd961c-d5d9-4647-85f3-ed4e0aa201df

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Capital Requirement %' = DIVIDE([Total Capital Requirement],[Total RWA])
				formatString: 0
				displayFolder: 2 - Capital Requirement
				lineageTag: 6132a5f8-2526-4860-9749-46523e9b0d86

			measure 'RWA Actual' = CALCULATE([Total RWA],Dim_Scenario[ScenarioCode] = "Actual")
				formatString: 0
				displayFolder: 1 - RWA
				lineageTag: 2460aca9-5807-4e04-bc10-1709425f25c9

			measure 'RWA Budget' = CALCULATE([Total RWA],Dim_Scenario[ScenarioCode] = "Budget")
				formatString: 0
				displayFolder: 1 - RWA
				lineageTag: 52a1ddb0-e025-47c8-ab96-b5ae46011ef9

			measure 'RWA Variance' = ```
					
					VAR ActualMonths =
						CALCULATETABLE(VALUES(Fact_Exposure[ReportMonth]),Dim_Scenario[ScenarioCode] = "Actual")
					VAR BudgetMonths =
						CALCULATETABLE(VALUES(Fact_Exposure[ReportMonth]),Dim_Scenario[ScenarioCode] = "Budget")
					VAR SharedMonths = 
						TREATAS(INTERSECT( ActualMonths, BudgetMonths ), Dim_Date[Date])
					VAR RWAActual = CALCULATE([RWA Actual],SharedMonths)
					VAR RWABudget = CALCULATE([RWA Budget],SharedMonths)
					
					RETURN
					RWAActual - RWABudget
					
					
					```
				formatString: 0
				displayFolder: 1 - RWA
				lineageTag: c2fd2041-4d7f-496a-b593-9b39885b7b0d

			measure 'RWA Budget Shared M' = ```
					
					
					VAR ActualMonths =
						CALCULATETABLE(VALUES(Fact_Exposure[ReportMonth]),Fact_Exposure[ScenarioCode] = "Actual")
					VAR BudgetMonths =
						CALCULATETABLE(VALUES(Fact_Exposure[ReportMonth]),Fact_Exposure[ScenarioCode] = "Budget")
					VAR SharedMonths = 
						INTERSECT(ActualMonths,BudgetMonths)
					
					RETURN
					
					CALCULATE([RWA Budget],SharedMonths)
					
					```
				displayFolder: 1 - RWA
				lineageTag: 8061dafe-704f-46e2-b027-c13a3c5d7f6a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'RWA Variance %' = ```
					
					VAR ActualMonths =
						CALCULATETABLE(VALUES(Fact_Exposure[ReportMonth]),Dim_Scenario[ScenarioCode] = "Actual")
					VAR BudgetMonths =
						CALCULATETABLE(VALUES(Fact_Exposure[ReportMonth]),Dim_Scenario[ScenarioCode] = "Budget")
					VAR SharedMonths = 
						TREATAS(INTERSECT( ActualMonths, BudgetMonths ), Dim_Date[Date])
					
					RETURN
					
					DIVIDE([RWA Variance],CALCULATE([RWA Budget],SharedMonths))
					
					```
				displayFolder: 1 - RWA
				lineageTag: ba3636e1-6cec-489f-9c8e-f5bb897d972e

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'RWA Prior Month' =
					
					
					CALCULATE([Total RWA],PREVIOUSMONTH(Dim_Date[Date]))
				displayFolder: 1 - RWA
				lineageTag: 0c4172c7-8739-4c41-9d31-fd0452f7d037

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'RWA MoM %' =
					
					DIVIDE([Total RWA] - [RWA Prior Month],[RWA Prior Month])
				displayFolder: 1 - RWA
				lineageTag: 5d217eae-674e-4bc3-8978-f0c054cfc3cd

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'RWA Rolling 3M Avg' =
					
					IF(
					    NOT ISBLANK( [Total RWA] ),
					    DIVIDE(
					        CALCULATE(
					            [Total RWA],
					            DATESINPERIOD( Dim_Date[Date], MAX( Dim_Date[Date] ), -[Months in Rolling Window], MONTH )
					        ),
					        [Months in Rolling Window]
					    )
					)
				displayFolder: 1 - RWA
				lineageTag: 52b2bba1-701d-4c5d-8467-74b25e0d9243

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Months in Rolling Window' =
					
					IF(
					    NOT ISBLANK( [Total RWA] ),
					    VAR LastReportMonth = MAX( Dim_Date[Date] )
					    VAR MonthWindow = DATESINPERIOD( Dim_Date[Date], LastReportMonth, -3, MONTH )
					    RETURN
					        CALCULATE( DISTINCTCOUNT( Fact_Exposure[ReportMonth] ), MonthWindow )
					)
				formatString: 0
				displayFolder: 3 - Other
				lineageTag: fe901116-92c2-43a3-8fd8-5a0c15eca5e4

			measure 'Capital Requirement incl. Buffer' =
					
					[Total Capital Requirement] + ([Total RWA] * .025)
				displayFolder: 2 - Capital Requirement
				lineageTag: 22119abf-47bf-4d5a-8af8-9bba70621d81

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Total Capital Requirement' = SUM(Fact_Exposure[CapitalRequirement])
				displayFolder: 2 - Capital Requirement
				lineageTag: b9d1daf4-fa0c-4dfc-ab7f-c193ab07b756

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Title - Executive Summary' = "Executive Summary - Capital Requirements Monitoring"
				displayFolder: 5 - Titles
				lineageTag: fdaf6cb0-7dcc-44e1-afc8-5e4713a9d132

			measure 'Capital Requirement Actual' =
					
					CALCULATE([Total Capital Requirement],Dim_Scenario[ScenarioCode] = "Actual")
				displayFolder: 2 - Capital Requirement
				lineageTag: 943b72f3-699d-4224-94bb-1d237684792b

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Capital Requirement Budget' =
					
					CALCULATE([Total Capital Requirement],Dim_Scenario[ScenarioCode] = "Budget")
				displayFolder: 2 - Capital Requirement
				lineageTag: 14ac342f-f556-403e-b198-91bf8391c229

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Capital Requirement Variance' = ```
					
					VAR ActualMonths =
						CALCULATETABLE(VALUES(Fact_Exposure[ReportMonth]),Dim_Scenario[ScenarioCode] = "Actual")
					VAR BudgetMonths =
						CALCULATETABLE(VALUES(Fact_Exposure[ReportMonth]),Dim_Scenario[ScenarioCode] = "Budget")
					VAR SharedMonths = 
						TREATAS(INTERSECT( ActualMonths, BudgetMonths ), Dim_Date[Date])
					VAR CRActual = CALCULATE([Capital Requirement Actual],SharedMonths)
					VAR CRBudget = CALCULATE([Capital Requirement Budget],SharedMonths)
					
					RETURN
					CRActual - CRBudget
					```
				displayFolder: 2 - Capital Requirement
				lineageTag: 5e980a26-acfb-4153-b9d1-a12fd43c4f4a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Title - Country - Segment Analysis' = "Country-Segment Analysis"
				displayFolder: 5 - Titles
				lineageTag: 26f293ce-9deb-4abb-b8e0-cb65f065a774

			measure 'Title - Variance Trend and Data Quality' = "Variance Trends & Data Quality"
				displayFolder: 5 - Titles
				lineageTag: 9cf1d668-e132-4aad-9736-eb7d0a5853f2

			measure 'Title - Exposure Detail' =
					
					"Exposure detail for "
					    & IF( ISFILTERED( Dim_Country[CountryName] ),
					          CONCATENATEX( VALUES( Dim_Country[CountryName] ), Dim_Country[CountryName], ", " ),
					          "all countries" )
					    & ", "
					    & IF( ISFILTERED( Dim_Segment[SegmentName] ),
					          CONCATENATEX( VALUES( Dim_Segment[SegmentName] ), Dim_Segment[SegmentName], ", " ) & " segment",
					          "all segments" )
					    & ", and "
					    & IF( ISFILTERED( Dim_Scenario[ScenarioCode] ),
					          CONCATENATEX( VALUES( Dim_Scenario[ScenarioCode] ), Dim_Scenario[ScenarioCode], ", " ) & " scenario",
					          "all scenarios" )
				displayFolder: 5 - Titles
				lineageTag: d6dbce5c-80fd-4760-8ad5-044e0c48701a

			measure 'Capital Requirement Variance %' = ```
					
					VAR ActualMonths =
						CALCULATETABLE(VALUES(Fact_Exposure[ReportMonth]),Dim_Scenario[ScenarioCode] = "Actual")
					VAR BudgetMonths =
						CALCULATETABLE(VALUES(Fact_Exposure[ReportMonth]),Dim_Scenario[ScenarioCode] = "Budget")
					VAR SharedMonths = 
						TREATAS(INTERSECT( ActualMonths, BudgetMonths ), Dim_Date[Date])
					
					RETURN
					
					DIVIDE([Capital Requirement Variance],CALCULATE([Capital Requirement Budget],SharedMonths))
					```
				displayFolder: 2 - Capital Requirement
